# Optional. Default: ~/.grok
GROK_HOME=

# Optional local gate. If set, Codex must send Authorization: Bearer $PROXY_API_KEY
PROXY_API_KEY=

# Optional. Overrides whichever upstream is active.
XAI_BASE_URL=

# Optional. Default: https://cli-chat-proxy.grok.com/v1
GROK_CLI_CHAT_PROXY_BASE_URL=

# Optional. Default: version in ~/.grok/version.json, else 1.0.30
GROK_CLIENT_VERSION=
